# Variables de entorno para METTAV
#
# Copia este archivo como `.env` (docker compose lo lee automáticamente) o
# configúralas en Coolify en "Environment Variables".
# NUNCA subas un .env real al repositorio: `.gitignore` ya lo excluye.

# Clave secreta de Flask. Si se deja vacía (o con este valor de ejemplo) la app
# genera una aleatoria y la guarda en instance/secret_key.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera-aqui-una-clave-larga-y-aleatoria

# Base de datos. Vacía = SQLite en instance/mi_proyecto.sqlite3.
# Para PostgreSQL: postgresql://usuario:clave@servidor:5432/mettav
DATABASE_URL=

# Primer administrador. Solo se usa si ese usuario todavía no existe en la BD.
# La contraseña debe tener 12+ caracteres, mezclar letras y números/símbolos y no ser
# común: si no cumple (o se deja la de ejemplo), el administrador NO se crea.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Sesiones (JWT en cookies HttpOnly) ---
# Minutos de vida del token de acceso; se renueva solo mientras haya actividad.
JWT_ACCESO_MINUTOS=15
# Minutos sin actividad tras los cuales se cierra la sesión.
JWT_INACTIVIDAD_MINUTOS=30
# Duración máxima de una sesión, aunque haya actividad.
JWT_SESION_MAX_HORAS=12
# 1 = las cookies siempre llevan Secure (usar en producción con HTTPS).
COOKIE_SECURE=
# Detrás de un proxy (Coolify): TRUST_PROXY=1 y cuántos proxies de confianza hay delante.
TRUST_PROXY=
TRUST_PROXY_HOPS=1

# Puerto del host donde se publica la app SOLO con docker-compose.local.yml
# (en Coolify no se usa: el tráfico entra por su proxy en 80/443).
APP_PORT=8000

# Asistente con IA (Google Gemini). Si no se define, el chat avisa que no está configurado.
# Crea la clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo opcional (por defecto gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
